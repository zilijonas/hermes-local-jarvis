<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.jarvis.jarvisd</string>

    <key>ProgramArguments</key>
    <array>
        <string>@REPO@/service/.venv/bin/python</string>
        <string>-m</string>
        <string>jarvisd.app</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@REPO@/service</string>

    <!-- No cloud API keys set here — the worker backend default ("cloud") talks
         to OpenCode Go through the `default` Hermes profile (hermes -p default -z),
         with a local gpt-oss fallback; any cloud keys it needs are read from
         ~/.hermes/.env by the process, not embedded in this plist. STT/TTS stay
         on-box regardless of worker backend (see ARCHITECTURE.md). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HERMES_HOME</key>
        <string>/Users/agent/ai/state/jarvis-voice/hermes-home</string>
        <key>PATH</key>
        <string>/Users/agent/.local/bin:/Users/agent/ai/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>LimitLoadToSessionType</key>
    <array>
        <string>Aqua</string>
        <string>Background</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/agent/ai/state/jarvis-voice/logs/jarvisd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/agent/ai/state/jarvis-voice/logs/jarvisd.err.log</string>
</dict>
</plist>
